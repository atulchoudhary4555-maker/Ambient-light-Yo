<?xml version="1.0" encoding="utf-8"?>
<!-- 1. यहाँ से package टैग को पूरी तरह हटा दिया गया है -->
<manifest xmlns:android="http://android.com">

    <!-- इंटरनेट इस्तेमाल करने की अनुमति -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:label="Ambient Light for YouTube"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name="com.shubham.ambientlight.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 2. यहाँ मिसिंग android:name को ठीक कर दिया गया है -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
            
